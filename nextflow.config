/*
 * ECM Target Discovery Pipeline - Nextflow Configuration
 *
 * Orchestrates R and Python analysis steps for the
 * CPTAC PDAC multi-omics ECM target discovery workflow.
 */

params {
    // Input parameters (override with -params-file params.yaml)
    params_file = "params.yaml"
    outdir      = "results"
    figdir      = "figures"
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
    }

    docker {
        docker.enabled = true
    }
}

// Execution report
report {
    enabled = true
    file    = "evidence/logs/nextflow_report.html"
}

timeline {
    enabled = true
    file    = "evidence/logs/nextflow_timeline.html"
}

trace {
    enabled = true
    file    = "evidence/logs/nextflow_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss'
}

// Process defaults
process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: 'r_process' {
        // R processes
    }

    withLabel: 'python_process' {
        // Python processes
    }
}

manifest {
    name            = 'gbadedata/ecm-target-discovery-pipeline'
    author          = 'Oluwagbade Odimayo'
    description     = 'Multi-omics ECM target discovery workflow for PDAC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.0'
    version         = '0.1.0'
}
